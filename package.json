{
  "name": "draycomply",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p . && tsc --noEmit -p apps/web",
    "test": "vitest run",
    "test:integration": "vitest run -c vitest.integration.config.ts",
    "build": "npm run build -w @draycomply/web",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build",
    "check:full": "npm run check && npm run test:integration && npm run e2e",
    "e2e": "playwright test -c apps/web/playwright.config.ts",
    "e2e:smoke": "node apps/web/e2e/smoke.mjs",
    "db:generate": "drizzle-kit generate --config packages/db/drizzle.config.ts",
    "db:migrate": "tsx packages/db/src/migrate.ts",
    "db:seed-demo": "tsx apps/web/scripts/seed-demo.ts",
    "dev": "npm run dev -w @draycomply/web"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@playwright/test": "^1.65.1",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.0.0",
    "playwright": "^1.65.1",
    "tsx": "^4.23.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "next": {
      "postcss": "^8.5.23"
    }
  }
}
