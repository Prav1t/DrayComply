# Copy to .env for local work. Never commit a real .env. In production these are set in the host's dashboard.

# Postgres connection string. Local default matches the test role.
DATABASE_URL=postgresql://dray:dray@localhost:5432/dray_dev

# The public origin of the app, no trailing slash. State-changing requests from any other origin are refused.
APP_URL=http://localhost:3000

# "true" lets anyone create an organization. Keep "false" in production and create organizations with: npm run org:create
SIGNUP_OPEN=true

# Header your host's proxy sets to the caller's address, used only for sign-in rate limiting.
# DigitalOcean App Platform: do-connecting-ip. Local: leave unset.
# CLIENT_IP_HEADER=do-connecting-ip

# PEM certificate of the managed database's CA, if it uses a private CA. Leave unset locally.
# DATABASE_CA_CERT=

# Optional. Errors are POSTed here as {app, errorName, route, requestId}. Never a message, never customer data.
# ERROR_WEBHOOK_URL=

# Integration and end-to-end tests: a Postgres where the role may CREATE DATABASE.
TEST_DATABASE_URL=postgresql://dray:dray@localhost:5432/postgres
